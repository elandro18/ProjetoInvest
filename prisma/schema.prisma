// Schema Prisma — Investment Control
// Convenções: snake_case nas tabelas/colunas (specs/DATA_MODEL.md §2), UUID como PK,
// dinheiro em Decimal (ADR-006). Apenas dados de referência nesta primeira migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Como o provedor de dados se autentica nas chamadas externas (RN-030).
enum AutenticacaoProvedor {
  NENHUMA
  API_KEY
  OAUTH

  @@map("autenticacao_provedor")
}

/// Resultado de uma chamada a provedor externo (RN-074).
enum StatusIntegracao {
  SUCESSO
  ERRO
  TIMEOUT
  LIMITE
  DADOS_INCOMPLETOS

  @@map("status_integracao")
}

/// Estado do ciclo de vida da conta (RN-085, DATA_MODEL.md §3).
enum StatusConta {
  PENDENTE_VERIFICACAO
  ATIVA
  SUSPENSA
  EXCLUIDA

  @@map("status_conta")
}

/// Finalidade do token de conta (RN-085, RN-086).
enum TipoTokenConta {
  VERIFICACAO_EMAIL
  REDEFINICAO_SENHA

  @@map("tipo_token_conta")
}

/// Situação do ativo na carteira do titular (RN-013).
enum StatusAtivo {
  ATIVO
  INATIVO
  EM_ANALISE

  @@map("status_ativo")
}

/// Documento legal versionado aceito no cadastro (RN-087).
enum TipoAceiteLegal {
  TERMOS_USO
  POLITICA_PRIVACIDADE

  @@map("tipo_aceite_legal")
}

/// Produto de renda fixa (RN-057, DATA_MODEL.md §4.8).
enum ProdutoRendaFixa {
  TESOURO_SELIC
  TESOURO_IPCA
  TESOURO_PREFIXADO
  CDB
  LCI
  LCA
  DEBENTURE
  OUTRO

  @@map("produto_renda_fixa")
}

/// Indexador contratado do título (RN-057).
enum IndexadorRendaFixa {
  PRE
  POS_CDI
  IPCA
  SELIC
  OUTRO

  @@map("indexador_renda_fixa")
}

/// Liquidez contratada do título (RN-057).
enum LiquidezRendaFixa {
  DIARIA
  NO_VENCIMENTO
  PRAZO

  @@map("liquidez_renda_fixa")
}

/// Confiança do saldo informado pelo titular (RN-059).
enum StatusSaldo {
  INFORMADO
  ESTIMADO
  CONFIRMADO

  @@map("status_saldo")
}

/// Tipo do fato que altera posição, caixa ou rendimento (RN-014).
enum TipoMovimentacao {
  COMPRA
  VENDA
  DIVIDENDO
  JUROS
  APLICACAO_RF
  RESGATE_RF
  TAXA

  @@map("tipo_movimentacao")
}

/// Natureza do provento recebido (RN-017).
enum TipoRendimento {
  DIVIDENDO
  JURO
  AMORTIZACAO

  @@map("tipo_rendimento")
}

/// Proveniência do dado (RN-014, RN-030).
enum OrigemDado {
  MANUAL
  PROVEDOR
  IMPORTACAO_CVM

  @@map("origem_dado")
}

/// Catálogo de classes de ativo (RENDA_FIXA, FII). Dado de referência, não do usuário.
model ClasseAtivo {
  id        String          @id @default(uuid()) @db.Uuid
  codigo    String          @unique @db.VarChar(30)
  nome      String          @db.VarChar(60)
  ativo     Boolean         @default(true)
  ordem     Int             @default(0) @db.SmallInt
  segmentos SegmentoAtivo[]
  ativos    Ativo[]

  @@map("classe_ativo")
}

/// Subdivisão de uma classe (hoje, dos FIIs).
model SegmentoAtivo {
  id       String      @id @default(uuid()) @db.Uuid
  classeId String      @map("classe_id") @db.Uuid
  codigo   String      @db.VarChar(40)
  nome     String      @db.VarChar(80)
  ativo    Boolean     @default(true)
  ordem    Int         @default(0) @db.SmallInt
  classe   ClasseAtivo @relation(fields: [classeId], references: [id], onDelete: Restrict)
  ativos   Ativo[]

  @@unique([classeId, codigo])
  @@index([classeId])
  @@map("segmento_ativo")
}

/// Cadastro de provedores externos com capacidades e prioridade de resolução (RN-030).
model ProvedorDados {
  id                String               @id @default(uuid()) @db.Uuid
  nome              String               @unique @db.VarChar(60)
  capacidades       Json
  autenticacao      AutenticacaoProvedor @default(NENHUMA)
  limiteRequisicoes String?              @map("limite_requisicoes") @db.VarChar(60)
  custo             String?              @db.VarChar(160)
  prioridade        Int                  @default(100) @db.SmallInt
  ativo             Boolean              @default(true)
  atualizadoEm      DateTime             @default(now()) @map("atualizado_em") @db.Timestamptz(6)
  logs              LogIntegracao[]

  @@map("provedor_dados")
}

/// Auditoria de cada chamada a provedor externo (RN-074).
model LogIntegracao {
  id             String           @id @default(uuid()) @db.Uuid
  provedorId     String           @map("provedor_id") @db.Uuid
  operacao       String           @db.VarChar(60)
  recurso        String?          @db.VarChar(120)
  status         StatusIntegracao
  httpStatus     Int?             @map("http_status") @db.SmallInt
  duracaoMs      Int?             @map("duracao_ms")
  dataConsulta   DateTime         @map("data_consulta") @db.Timestamptz(6)
  dataReferencia DateTime?        @map("data_referencia") @db.Date
  mensagem       String?          @db.VarChar(1000)
  criadoEm       DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  provedor       ProvedorDados    @relation(fields: [provedorId], references: [id], onDelete: Restrict)

  @@index([provedorId, criadoEm(sort: Desc)], map: "ix_log_provedor_criado")
  @@index([status, criadoEm(sort: Desc)], map: "ix_log_status_criado")
  @@map("log_integracao")
}

/// Titular da conta (RN-070, RN-071, RN-085). E-mail sempre normalizado em
/// minúsculas; a unicidade case-insensitive é garantida pelo índice funcional
/// `ux_usuario_email (lower(email))` criado na migration (Prisma não o expressa).
model Usuario {
  id                String        @id @default(uuid()) @db.Uuid
  nome              String        @db.VarChar(120)
  email             String        @db.VarChar(160)
  senhaHash         String        @map("senha_hash")
  statusConta       StatusConta   @default(PENDENTE_VERIFICACAO) @map("status_conta")
  /// Versão da sessão; incrementada para invalidar todos os JWT emitidos (RN-085, RN-086, RN-088).
  sessionVersion    Int           @default(0) @map("session_version")
  emailVerificadoEm DateTime?     @map("email_verificado_em") @db.Timestamptz(6)
  ultimoLoginEm     DateTime?     @map("ultimo_login_em") @db.Timestamptz(6)
  criadoEm          DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm      DateTime      @default(now()) @map("atualizado_em") @db.Timestamptz(6)
  excluidoEm        DateTime?     @map("excluido_em") @db.Timestamptz(6)
  tokens            TokenConta[]
  aceites           AceiteLegal[]
  ativos            Ativo[]
  rendaFixa         InvestimentoRendaFixa[]
  movimentacoes     Movimentacao[]
  posicoes          PosicaoAtivo[]
  rendimentos       Rendimento[]

  @@map("usuario")
}

/// Token de uso único para verificação de e-mail ou redefinição de senha
/// (RN-085, RN-086). Persistido apenas como SHA-256.
model TokenConta {
  id        String         @id @default(uuid()) @db.Uuid
  usuarioId String         @map("usuario_id") @db.Uuid
  tipo      TipoTokenConta
  tokenHash String         @unique(map: "ux_token_hash") @map("token_hash") @db.VarChar(128)
  expiraEm  DateTime       @map("expira_em") @db.Timestamptz(6)
  usadoEm   DateTime?      @map("usado_em") @db.Timestamptz(6)
  criadoEm  DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  usuario   Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo, criadoEm(sort: Desc)], map: "ix_token_usuario_tipo")
  @@map("token_conta")
}

/// Ativo cadastrado pelo titular (RN-010). `ux_ativo_usuario_ticker` garante
/// unicidade por usuário; `chk_ativo_ticker_formato` é aplicado na migration
/// (Prisma não expressa CHECK). A obrigatoriedade de segmento para FII depende
/// de `classe_ativo.codigo` e é validada no domínio, não como CHECK simples.
model Ativo {
  id            String         @id @default(uuid()) @db.Uuid
  usuarioId     String         @map("usuario_id") @db.Uuid
  ticker        String         @db.VarChar(20)
  nome          String         @db.VarChar(160)
  classeId      String         @map("classe_id") @db.Uuid
  segmentoId    String?        @map("segmento_id") @db.Uuid
  cnpj          String?        @db.VarChar(14)
  administrador String?        @db.VarChar(160)
  gestor        String?        @db.VarChar(160)
  status        StatusAtivo    @default(ATIVO)
  fonteDados    String?        @map("fonte_dados") @db.VarChar(60)
  observacoes   String?        @db.Text
  criadoEm      DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime       @default(now()) @map("atualizado_em") @db.Timestamptz(6)
  usuario       Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  classe        ClasseAtivo    @relation(fields: [classeId], references: [id], onDelete: Restrict)
  segmento      SegmentoAtivo? @relation(fields: [segmentoId], references: [id], onDelete: Restrict)
  movimentacoes Movimentacao[]
  posicoes      PosicaoAtivo[]
  rendimentos   Rendimento[]

  @@unique([usuarioId, ticker], map: "ux_ativo_usuario_ticker")
  @@index([usuarioId, status], map: "ix_ativo_usuario_status")
  @@index([segmentoId], map: "ix_ativo_segmento")
  @@map("ativo")
}

/// Título de renda fixa do titular (RN-057, DATA_MODEL.md §4.8). Não gera
/// `posicao_ativo`: a consolidação da carteira soma `saldo_atual`. Os CHECKs de
/// taxa/valor/vencimento e o trigger de `atualizado_em` são aplicados na
/// migration (Prisma não expressa CHECK).
model InvestimentoRendaFixa {
  id            String              @id @default(uuid()) @db.Uuid
  usuarioId     String              @map("usuario_id") @db.Uuid
  instituicao   String              @db.VarChar(120)
  produto       ProdutoRendaFixa
  indexador     IndexadorRendaFixa
  taxa          Decimal             @db.Decimal(9, 6)
  dataAplicacao DateTime            @map("data_aplicacao") @db.Date
  vencimento    DateTime?           @db.Date
  valorAplicado Decimal             @map("valor_aplicado") @db.Decimal(18, 2)
  saldoAtual    Decimal             @map("saldo_atual") @db.Decimal(18, 2)
  statusSaldo   StatusSaldo         @default(INFORMADO) @map("status_saldo")
  liquidez      LiquidezRendaFixa
  carenciaAte   DateTime?           @map("carencia_ate") @db.Date
  coberturaFgc  Boolean             @default(false) @map("cobertura_fgc")
  observacoes   String?             @db.Text
  criadoEm      DateTime            @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime            @default(now()) @map("atualizado_em") @db.Timestamptz(6)
  usuario       Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId, vencimento], map: "ix_rf_usuario_vencimento")
  @@index([usuarioId, instituicao], map: "ix_rf_usuario_instituicao")
  @@map("investimento_renda_fixa")
}

/// Razão de fatos financeiros do titular (RN-014, DATA_MODEL.md §4.5).
/// Os CHECKs de quantidade/valor e o índice único parcial de idempotência são
/// aplicados na migration (Prisma não expressa CHECK nem índice parcial).
model Movimentacao {
  id                 String           @id @default(uuid()) @db.Uuid
  usuarioId          String           @map("usuario_id") @db.Uuid
  ativoId            String           @map("ativo_id") @db.Uuid
  tipo               TipoMovimentacao
  data               DateTime         @db.Date
  quantidade         Decimal?         @db.Decimal(18, 8)
  valorUnitario      Decimal?         @map("valor_unitario") @db.Decimal(18, 2)
  valorTotal         Decimal          @map("valor_total") @db.Decimal(18, 2)
  custos             Decimal          @default(0) @db.Decimal(18, 2)
  observacoes        String?          @db.Text
  canceladaEm        DateTime?        @map("cancelada_em") @db.Timestamptz(6)
  cancelamentoMotivo String?          @map("cancelamento_motivo") @db.Text
  idempotencyKey     String?          @map("idempotency_key") @db.VarChar(64)
  criadoEm           DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  usuario            Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  ativo              Ativo            @relation(fields: [ativoId], references: [id], onDelete: Restrict)
  rendimentos        Rendimento[]
  posicoes           PosicaoAtivo[]   @relation("UltimaMovimentacao")

  @@index([usuarioId, data(sort: Desc)], map: "ix_mov_usuario_data")
  @@index([ativoId, data], map: "ix_mov_ativo_data")
  @@map("movimentacao")
}

/// Cache derivado da posição por ativo (RN-015, DATA_MODEL.md §4.6).
/// Reconstruível a partir de `movimentacao`; nunca é fonte primária.
model PosicaoAtivo {
  usuarioId            String        @map("usuario_id") @db.Uuid
  ativoId              String        @map("ativo_id") @db.Uuid
  quantidade           Decimal       @db.Decimal(18, 8)
  precoMedio           Decimal       @map("preco_medio") @db.Decimal(18, 6)
  custoTotal           Decimal       @map("custo_total") @db.Decimal(18, 2)
  ultimaMovimentacaoId String?       @map("ultima_movimentacao_id") @db.Uuid
  atualizadoEm         DateTime      @default(now()) @map("atualizado_em") @db.Timestamptz(6)
  usuario              Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  ativo                Ativo         @relation(fields: [ativoId], references: [id], onDelete: Restrict)
  ultimaMovimentacao   Movimentacao? @relation("UltimaMovimentacao", fields: [ultimaMovimentacaoId], references: [id], onDelete: Restrict)

  @@id([usuarioId, ativoId])
  @@map("posicao_ativo")
}

/// Provento recebido, separado do resultado de capital (RN-017, DATA_MODEL.md §4.7).
model Rendimento {
  id             String          @id @default(uuid()) @db.Uuid
  usuarioId      String          @map("usuario_id") @db.Uuid
  ativoId        String          @map("ativo_id") @db.Uuid
  tipo           TipoRendimento
  dataPagamento  DateTime        @map("data_pagamento") @db.Date
  competencia    String?         @db.Char(7)
  valor          Decimal         @db.Decimal(18, 2)
  origem         OrigemDado
  movimentacaoId String?         @map("movimentacao_id") @db.Uuid
  criadoEm       DateTime        @default(now()) @map("criado_em") @db.Timestamptz(6)
  usuario        Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  ativo          Ativo           @relation(fields: [ativoId], references: [id], onDelete: Restrict)
  movimentacao   Movimentacao?   @relation(fields: [movimentacaoId], references: [id], onDelete: Restrict)

  @@index([usuarioId, dataPagamento], map: "ix_rend_usuario_data")
  @@index([ativoId, competencia], map: "ix_rend_ativo_competencia")
  @@map("rendimento")
}

/// Evidência de consentimento legal versionado (RN-087). Nunca guarda IP puro.
model AceiteLegal {
  id        String          @id @default(uuid()) @db.Uuid
  usuarioId String          @map("usuario_id") @db.Uuid
  tipo      TipoAceiteLegal
  versao    String          @db.VarChar(20)
  aceitoEm  DateTime        @default(now()) @map("aceito_em") @db.Timestamptz(6)
  ipHash    String?         @map("ip_hash") @db.VarChar(64)
  usuario   Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo, aceitoEm(sort: Desc)], map: "ix_aceite_usuario_tipo")
  @@map("aceite_legal")
}
