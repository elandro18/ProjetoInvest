# ==== Banco de dados (Neon) — ARCHITECTURE.md §8 ====
# Conexão pooled usada em runtime.
DATABASE_URL=
# Conexão direta usada por migrations.
DIRECT_URL=

# ==== Autenticação — ARCHITECTURE.md §9 ====
# Segredo de assinatura de sessão (mínimo 32 bytes).
AUTH_SECRET=
# Base pública usada nos links enviados por e-mail (ex.: http://localhost:3000).
APP_URL=
# Salt do hash de IP de auditoria (fallback: AUTH_SECRET).
IP_HASH_SALT=

# ==== E-mail transacional — ARCHITECTURE.md §9 ====
# String de conexão SMTP/API do provedor de e-mail.
EMAIL_SERVER=
# Remetente exibido nas mensagens.
EMAIL_FROM=

# ==== Provedores de dados de mercado — ARCHITECTURE.md §9 ====
# Chave de API do provedor de mercado (somente servidor).
PROVIDER_MERCADO_API_KEY=
# Base URL dos dados abertos da CVM.
PROVIDER_CVM_BASE_URL=
